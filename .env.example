# Copy this file to `.env` and fill in your real keys. `.env` is gitignored.
#
# Etherscan API (free tier) — used to trace wallet funding sources / first transactions
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Alchemy NFT API — primary trade-data source (getNFTSales). Free tier.
# Get one at https://dashboard.alchemy.com (create an Ethereum Mainnet app)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Dune Analytics API — optional fallback source (nft.trades)
# Get one at https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# CockroachDB Cloud — connection string from the Cloud Console (contains a password,
# so it lives here in .env, never committed). Looks like:
# postgresql://user:pass@host.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
COCKROACH_DATABASE_URL=your_cockroach_connection_string_here

# AWS Bedrock — embeddings (Titan Text Embeddings V2) + flag explanations (Claude).
# Create an IAM user with Bedrock access, make an access key, and paste it here.
# (These are secrets; .env is gitignored. Alternatively use `aws configure`.)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
