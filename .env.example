# Copy this file to `.env` and fill in your real keys. `.env` is gitignored.
#
# Etherscan API (free tier) — used to trace wallet funding sources / first transactions
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Alchemy NFT API — primary trade-data source (getNFTSales). Free tier.
# Get one at https://dashboard.alchemy.com (create an Ethereum Mainnet app)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Dune Analytics API — optional fallback source (nft.trades)
# Get one at https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# AWS: prefer `aws configure` / IAM roles over hardcoding keys here.
